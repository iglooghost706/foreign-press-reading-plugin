{
  "manifest_version": 3,
  "name": "外刊阅读",
  "version": "0.1.1",
  "description": "点词查义、双击入生词本、拖选词组/句子翻译 —— 直接在网页上读外刊。",
  "key": "",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://api.mymemory.translated.net/*",
    "https://translate.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "外刊阅读（点此开关）",
    "default_popup": "panel.html"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["engine.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["bridge.html", "dict-builtin.txt", "dict-ecdict.txt", "dict-lemmas.txt"],
      "matches": []
    }
  ]
}